# Backend settings. Copy this file to .env (in this folder) and fill in the values.
# .env is gitignored. Never put real values in this file: it is committed.

# Port for the REST API and Socket.IO.
PORT=5000

# MongoDB connection string. This one points at a local MongoDB. For Atlas,
# copy the connection string from your cluster's Connect dialog.
MONGO_DB_URI=mongodb://127.0.0.1:27017/chat-app-db

# Signs login tokens. Use a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# The frontend's origin: the only one allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:3000

# Set to production when deploying. Otherwise error responses include stack traces.
NODE_ENV=development

# Optional. Redis, for state shared by several backend servers (today: rate-limit
# counts). Works with real Redis or redis-in-java. Put a password in the URL:
#   redis://:<password>@127.0.0.1:6379
# Write 127.0.0.1, not localhost: Node may resolve localhost to ::1 (IPv6), where
# redis-in-java doesn't listen. Leave it empty to keep everything in memory.
# For TLS, start it with rediss:// and use the server's TLS port, for example
#   rediss://:<password>@127.0.0.1:6380
REDIS_URL=

# Optional, only with a rediss:// URL. Paths to PEM files: the authority that signed
# the Redis server's certificate, when Node doesn't already trust it (a self-signed
# or private one), and this backend's own certificate and key, for a server that
# requires client certificates (redis-in-java's REDIS_TLS_CLIENT_CA).
# REDIS_TLS_CA=/etc/chat/redis-ca.pem
# REDIS_TLS_CERT=/etc/chat/redis-client.pem
# REDIS_TLS_KEY=/etc/chat/redis-client.key

# Optional. How many proxies, such as a load balancer, sit in front of the server,
# so rate limits see each client's address instead of the proxy's. Leave it empty
# when clients connect directly. Never set more than there are.
TRUST_PROXY=

# Optional. Rate limits, shown with their defaults: failed logins per address and
# per username in 15 minutes (successful logins don't count), sign-ups per address
# in an hour, and messages per user in 10 seconds.
# RATE_LIMIT_LOGIN_PER_IP=20
# RATE_LIMIT_LOGIN_PER_USER=5
# RATE_LIMIT_SIGNUP_PER_IP=10
# RATE_LIMIT_SEND_PER_USER=20
