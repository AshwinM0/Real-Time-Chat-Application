# Backend settings. Copy this file to .env (in this folder) and fill in the values.
# .env is gitignored. Never put real values in this file: it is committed.

# Port for the REST API and Socket.IO.
PORT=5000

# MongoDB connection string. This one points at a local MongoDB. For Atlas,
# copy the connection string from your cluster's Connect dialog.
MONGO_DB_URI=mongodb://127.0.0.1:27017/chat-app-db

# Signs login tokens. Use a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# The frontend's origin: the only one allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:3000

# Set to production when deploying. Otherwise error responses include stack traces.
NODE_ENV=development
